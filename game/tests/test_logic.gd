extends SceneTree

const Logic = preload("res://scripts/classification.gd")


func _initialize() -> void:
	var full = Logic.new()
	assert(full.load_data(), "prototype data did not load")
	assert(full.entities.size() == 3)
	full.start()
	assert(full.entity()["entity_id"] == "cat")
	for question in full.entity()["steps"]:
		assert(full.choose(str(question["correct_category_id"]))["correct"])
	assert(full.card_results[0]["outcome"] == "complete")
	assert(full.card_results[0]["score_gained"] == 600, "fast complete score")
	assert(full.entity()["entity_id"] == "water")
	assert(full.observe())
	assert(not full.observe())
	assert(full.choose("physical")["correct"])
	assert(full.lock())
	assert(full.card_results[1]["score_gained"] == 7, "observe + lock rounding")
	assert(full.entity()["entity_id"] == "platypus")
	assert(full.depth == 3)
	full.skip()
	assert(full.is_finished())
	assert(full.total_score == 607)
	assert(full.chaos == 2)
	assert(full.card_results.size() == 3)
	assert(not full.save_log().is_empty())
	var wrong = Logic.new()
	assert(wrong.load_data())
	wrong.start()
	wrong.choose("physical")
	wrong.choose("non_living")
	assert(wrong.card_results[0]["outcome"] == "wrong")
	assert(wrong.card_results[0]["score_gained"] == 5)
	assert(wrong.chaos == 5)
	var fantasy = Logic.new()
	assert(fantasy.load_data("res://data/fantasy.json"))
	assert(fantasy.mode_id == "fantasy")
	fantasy.start()
	for specimen in range(fantasy.entities.size()):
		var current: Dictionary = fantasy.entity()
		assert(not str(current.get("field_note", "")).is_empty())
		for question in current["steps"]:
			assert(fantasy.choose(str(question["correct_category_id"]))["correct"])
	assert(fantasy.is_finished())
	assert(fantasy.card_results.size() == 6)
	var scar = Logic.new()
	assert(scar.load_data("res://data/fantasy.json"))
	scar.continue_on_wrong = true
	scar.start()
	assert(not scar.choose("crafted")["correct"])
	assert(scar.current_index == 0)
	assert(scar.depth == 2)
	assert(scar.chaos == 5)
	assert(scar.choose("light_feeder")["correct"])
	assert(scar.choose("spore_bearing")["correct"])
	assert(scar.card_results[0]["outcome"] == "mixed")
	assert(scar.card_results[0]["mistakes"] == 1)
	print("PASS: data, complete, observe, lock, skip, wrong, log")
	quit(0)
